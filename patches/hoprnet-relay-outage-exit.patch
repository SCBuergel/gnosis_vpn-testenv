From 8bb24625e4a8b5924dd14aa144f40ec63bd8f7b1 Mon Sep 17 00:00:00 2001
From: debug <debug@localhost>
Date: Fri, 9 Oct 2026 23:23:35 +0000
Subject: [PATCH 3/4] fix(hopr-lib): invalidate SURBs through a relay while the
 connection to it is down

---
 hopr/hopr-lib/src/builder.rs | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/hopr/hopr-lib/src/builder.rs b/hopr/hopr-lib/src/builder.rs
index a444013d76..c5fdd73922 100644
--- a/hopr/hopr-lib/src/builder.rs
+++ b/hopr/hopr-lib/src/builder.rs
@@ -621,16 +621,35 @@ where
     {
         let network_events = network.subscribe_network_events();
         let graph_updater = graph.clone();
+        // A relay we lose the connection to is no use as the first hop of a stored SURB: replying through it
+        // loses the packet. Mark it invalid in the SURB store until it connects again, as a closed channel is
+        // (T37-relay-outage: an exit kept spending SURBs through a silent relay long after it went away).
+        let surb_store = transport_api.surb_store().clone();
+        let key_ids = chain_api.clone();
         spawn(async move {
             network_events
                 .for_each(|event| {
                     let graph_updater = graph_updater.clone();
+                    let surb_store = surb_store.clone();
+                    let key_ids = key_ids.clone();
                     async move {
                         let (peer_id, connected) = match event {
                             hopr_api::network::NetworkEvent::PeerConnected(p) => (p, true),
                             hopr_api::network::NetworkEvent::PeerDisconnected(p) => (p, false),
                         };
                         if let Ok(opk) = hopr_api::OffchainPublicKey::from_peerid(&peer_id) {
+                            {
+                                use hopr_api::chain::{ChainKeyOperations, KeyIdMapping};
+                                use hopr_transport::SurbStore;
+                                if let Some(relayer) = key_ids.key_id_mapper_ref().map_key_to_id(&opk) {
+                                    if connected {
+                                        surb_store.revalidate_relayer(&relayer);
+                                    } else {
+                                        surb_store.invalidate_relayer(&relayer);
+                                    }
+                                    tracing::info!(%peer_id, connected, "SURB first-relayer validity follows the connection");
+                                }
+                            }
                             graph_updater.record_edge(hopr_api::graph::MeasurableEdge::<
                                 hopr_transport::NeighborTelemetry,
                                 hopr_transport::PathTelemetry,
